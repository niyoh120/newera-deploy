:80 {
	encode zstd gzip

	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Land directly in the editor
	@root path /
	redir @root /editor/ 302

	# Saved projects handed over from the headless serve (read-only volume)
	# handle_path strips the /files prefix: /files/x.newera -> /srv/projects/x.newera
	handle_path /files/* {
		root * /srv/projects
		file_server browse
	}

	handle {
		root * /srv/web
		file_server
	}
}
